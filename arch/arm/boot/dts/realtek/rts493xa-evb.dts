#include "rts4930a.dtsi"
#include <dt-bindings/interrupt-controller/realtek,rts591x-iomatrix.h>

/ {
	model = "RTS493xA EVB";
	compatible = "realtek,rts493xa-evb","realtek,rts493xa";

	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&gic>;

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x8000000>;
	};

	chosen {
		bootargs = "console=ttyS1,57600 init=/sbin/init earlyprintk rootfstype=squashfs user_debug=31";
		stdout-path = &uart1;
	};

	iio-hwmon {
			compatible = "iio-hwmon";
			io-channels = <&rts_adc 0>,
					<&rts_adc 1>,
					<&rts_adc 2>,
					<&rts_adc 3>;
					/* Channels should correspond to the adc enabled channels
					<&rts_adc 4>,
					<&rts_adc 5>,
					<&rts_adc 6>,
					<&rts_adc 7>;
					*/
	};

	fan1 {
			compatible = "pwm-fan";
			cooling-levels = <0 102 170 230>;
			pwms = <&rts591x_pwm 0 40960 0>;
			pulses-per-revolution = <2>;
		};

	fan2 {
			compatible = "pwm-fan";
			cooling-levels = <0 102 170 230>;
			pwms = <&rts591x_pwm 1 40960 0>;
			pulses-per-revolution = <2>;
		};

};

&spi0 {
	status = "okay";
	spi-transfer-channel = "quad";
	swp_enable;
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "u-boot";
			reg = <0x00000 0xC0000>; //12*64K for uboot
		};

		partition@c0000 {
			label = "uboot-env";
			reg = <0xC0000 0x40000>; //4*64K for uboot env
		};

		partition@100000 {
			label = "kernel";
			reg = <0x100000 0x440000>; // 34*128K
		};

		partition@540000 {
			label = "rofs";
			reg = <0x540000 0x5B00000>; //728*128K
		};

		partition@6040000 {
			label = "rwfs";
			reg = <0x6040000 0x1FC0000>; //254*128K
		};
	};
};

&leds {
	ledbmc: identify {
		gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&uart0 {
	status = "okay";
};


&i2c0 {
	status = "okay";

	rts493xa-mfd@30 {
		compatible = "realtek,rts591x-mfd-i2c";
		reg = <0x30>;
		#address-cells = <1>;
		#size-cells = <0>;

		realtek,irq-status-reg = <0x20075000>;
		realtek,irq-ack-reg = <0x20075000>;

		mfd-gpios = <&pinctrl 60 GPIO_ACTIVE_LOW>;
		interrupt-controller;
		#interrupt-cells = <1>;

		iomatrix-uapi {
			compatible = "realtek,iomatrix-uapi";
		};

		peci {
			compatible = "realtek,rts591x-peci";
			reg = <0x40221900>;
			status = "disabled";
		};

		rts591x-peci-oob {
			compatible = "realtek,rts591x-peci-oob";
			status = "okay";
		};

		rts591x_gpio: gpio {
			compatible = "realtek,rts591x-gpio";
			reg = <0x40230000>;
			interrupts = <RTS591X_IOMATRIX_IRQ_GPIO21>,
				     <RTS591X_IOMATRIX_IRQ_GPIO41>,
				     <RTS591X_IOMATRIX_IRQ_GPIO42>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			gpio-line-names =
			"ESCM_GPIO000", "ESCM_GPIO001", "ESCM_GPIO002", "ESCM_GPIO003",
			"ESCM_GPIO004", "ESCM_GPIO005", "ESCM_GPIO006", "ESCM_GPIO007",
			"ESCM_GPIO008", "ESCM_GPIO009", "ESCM_GPIO010", "ESCM_GPIO011",
			"ESCM_GPIO012", "ESCM_GPIO013", "ESCM_GPIO014", "ESCM_GPIO015",
			"ESCM_GPIO016", "ESCM_GPIO017", "ESCM_GPIO018", "ESCM_GPIO019",
			"ESCM_GPIO020", "ESCM_GPIO021", "ESCM_GPIO022", "ESCM_GPIO023",
			"ESCM_GPIO024", "ESCM_GPIO025", "ESCM_GPIO026", "ESCM_GPIO027",
			"ESCM_GPIO028", "ESCM_GPIO029", "ESCM_GPIO030", "ESCM_GPIO031",
			"ESCM_GPIO032", "ESCM_GPIO033", "ESCM_GPIO034", "ESCM_GPIO035",
			"ESCM_GPIO036", "ESCM_GPIO037", "ESCM_GPIO038", "ESCM_GPIO039",
			"ESCM_GPIO040", "ESCM_GPIO041", "ESCM_GPIO042", "ESCM_GPIO043",
			"ESCM_GPIO044", "ESCM_GPIO045", "ESCM_GPIO046", "ESCM_GPIO047",
			"ESCM_GPIO048", "ESCM_GPIO049", "ESCM_GPIO050", "ESCM_GPIO051",
			"ESCM_GPIO052", "ESCM_GPIO053", "ESCM_GPIO054", "ESCM_GPIO055",
			"ESCM_GPIO056", "ESCM_GPIO057", "ESCM_GPIO058", "ESCM_GPIO059",
			"ESCM_GPIO060", "ESCM_GPIO061", "ESCM_GPIO062", "ESCM_GPIO063",
			"ESCM_GPIO064", "ESCM_GPIO065", "ESCM_GPIO066", "ESCM_GPIO067",
			"ESCM_GPIO068", "ESCM_GPIO069", "ESCM_GPIO070", "ESCM_GPIO071",
			"ESCM_GPIO072", "ESCM_GPIO073", "ESCM_GPIO074", "ESCM_GPIO075",
			"ESCM_GPIO076", "ESCM_GPIO077", "ESCM_GPIO078", "ESCM_GPIO079",
			"ESCM_GPIO080", "ESCM_GPIO081", "ESCM_GPIO082", "ESCM_GPIO083",
			"ESCM_GPIO084", "ESCM_GPIO085", "ESCM_GPIO086", "ESCM_GPIO087",
			"ESCM_GPIO088", "ESCM_GPIO089", "ESCM_GPIO090", "ESCM_GPIO091",
			"ESCM_GPIO092", "ESCM_GPIO093", "ESCM_GPIO094", "ESCM_GPIO095",
			"ESCM_GPIO096", "ESCM_GPIO097", "ESCM_GPIO098", "ESCM_GPIO099",
			"ESCM_GPIO100", "ESCM_GPIO101", "ESCM_GPIO102", "ESCM_GPIO103",
			"ESCM_GPIO104", "ESCM_GPIO105", "ESCM_GPIO106", "ESCM_GPIO107",
			"ESCM_GPIO108", "ESCM_GPIO109", "ESCM_GPIO110", "ESCM_GPIO111",
			"ESCM_GPIO112", "ESCM_GPIO113", "ESCM_GPIO114", "ESCM_GPIO115",
			"ESCM_GPIO116", "ESCM_GPIO117", "ESCM_GPIO118", "ESCM_GPIO119",
			"ESCM_GPIO120", "ESCM_GPIO121", "ESCM_GPIO122", "ESCM_GPIO123",
			"ESCM_GPIO124", "ESCM_GPIO125", "ESCM_GPIO126", "ESCM_GPIO127",
			"ESCM_GPIO128", "ESCM_GPIO129", "ESCM_GPIO130", "ESCM_GPIO131";
			status = "okay";
		};

		rts591x-i2c10 {
			compatible = "realtek,rts591x-i2c";
			reg = <0x40251200>;
			id = <10>;
			interrupts = <RTS591X_IOMATRIX_IRQ_I2C10>;
			status = "okay";
		};

		rts591x-i2c11 {
			compatible = "realtek,rts591x-i2c";
			reg = <0x40251400>;
			#address-cells = <1>;
			#size-cells = <0>;
			id = <11>;
			interrupts = <RTS591X_IOMATRIX_IRQ_I2C11>;
			status = "okay";

			eeprom@64 {
				compatible = "slave-24c02";
				reg = <0x40000064>;
			};
		};

		rts591x-i2c1 {
			compatible = "realtek,rts591x-i2c";
			reg = <0x40250000>;
			id = <1>;
			interrupts = <RTS591X_IOMATRIX_IRQ_I2C1>;
			status = "okay";
		};

		rts591x-i2c2 {
			compatible = "realtek,rts591x-i2c";
			reg = <0x40250200>;
			id = <2>;
			interrupts = <RTS591X_IOMATRIX_IRQ_I2C2>;
			status = "okay";
		};

		rts591x-i2c6 {
			compatible = "realtek,rts591x-i2c";
			reg = <0x40250A00>;
			#address-cells = <1>;
			#size-cells = <0>;
			id = <6>;
			interrupts = <RTS591X_IOMATRIX_IRQ_I2C6>;
			status = "okay";

			eeprom@64 {
				compatible = "slave-24c02";
				reg = <0x40000064>;
			};
		};

		rts_adc: rts591x-adc {
			compatible = "realtek,rts591x-adc";
			reg = <0x40251900>;
			linear-Calibration;
			mode = "repeat";
			status = "disabled";
			#io-channel-cells = <1>;

			channel@0{
				channel-en = "enabled";
				low-pass-filter;
			};

			channel@1{
				channel-en = "enabled";
				low-pass-filter;
			};

			channel@2{
				channel-en = "enabled";
				low-pass-filter;
			};

			channel@3{
				channel-en = "enabled";
				low-pass-filter;
			};

			channel@4{
				channel-en = "disabled";
				low-pass-filter;
			};

			channel@5{
				channel-en = "disabled";
				low-pass-filter;
			};

			channel@6{
				channel-en = "disabled";
				low-pass-filter;
			};

			channel@7{
				channel-en = "disabled";
				low-pass-filter;
			};
		};

		rts591x_pwm: rts591x_pwm_tacho {
			compatible = "realtek,rts591x-pwm-tacho";
			reg = <0x40254500>;
			clock-source= <0>; /*clock source selection*/
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
			#pwm-cells = <3>;

			fans {
				reg = <0x40251f00>;
				edge-selection = <0>;
				#address-cells = <1>;
				#size-cells = <0>;
				// cnt-ready-interrupt-en;
				rts591x-fan@0 {
					reg = <0x00>;
					fan-tach-ch = /bits/ 8 <0x00>;
				};

				rts591x-fan@1 {
					reg = <0x01>;
					fan-tach-ch = /bits/ 8 <0x01>;
				};

				rts591x-fan@2 {
					reg = <0x02>;
					fan-tach-ch = /bits/ 8 <0x02>;
				};

				rts591x-fan@3 {
					reg = <0x03>;
					fan-tach-ch = /bits/ 8 <0x03>;
				};
			};
		};

		rts591x-kcs-bmc {
			compatible = "realtek,rts591x-kcs-bmc";
			reg = <0x40221700>;
			interrupts = <RTS591X_IOMATRIX_IRQ_KCS_IBF>;
			kcs_chan = <1>;
			realtek,io-reg = <0xCA2 0xCA3>;
		};

		rts591x-espi-snoop {
			compatible = "realtek,rts591x-espi-snoop";
			reg = <0x40221200>;
			interrupts = <RTS591X_IOMATRIX_IRQ_PORT80>;
			snoop-channel = <0>;
		};
	};

	rts490xa-hub@70 {
		compatible = "realtek,rts490xa-hub";
		reg = <0x70>;

		cp0-ldo-en = "enabled";
		cp1-ldo-en = "enabled";
		cp0-ldo-volt = "1.8V";
		cp1-ldo-volt = "1.8V";
		tp0145-ldo-en = "enabled";
		tp2367-ldo-en = "enabled";
		tp0145-ldo-volt = "1.8V";
		tp2367-ldo-volt = "1.8V";
		tp0145-pullup = "500R";
		tp2367-pullup = "500R";
		tp0145-io-strength = "30Ohms";
		tp2367-io-strength = "30Ohms";
		cp0-io-strength = "20Ohms";
		cp1-io-strength = "20Ohms";

		target-port@0 {
			mode = "smbus";
			pullup = "enabled";
			mctp-controller;
			backend@0,0 {
				compatible = "mctp-i2c-controller";
				target-reg = <0x10>;
			};
		};

		target-port@1 {
			mode = "smbus";
			pullup = "enabled";
			backend@0,0 {
				compatible = "slave-mqueue";
				target-reg = <0x10>;
			};
		};

		target-port@4 {
			mode = "smbus";
			pullup = "enabled";
			backend@0,0 {
				compatible = "slave-mqueue";
				target-reg = <0x10>;
			};
		};

		target-port@5 {
			mode = "smbus";
			pullup = "enabled";
			backend@0,0 {
				compatible = "slave-mqueue";
				target-reg = <0x10>;
			};
		};
	};

	usb_hub: usb2hub@2c {
		compatible = "realtek,usb2hub-7port";
		reg = <0x2c>;
		reset-gpios = <&pinctrl 9 GPIO_ACTIVE_LOW>;
		vendor-id = /bits/ 16 <0x0BDA>;
		product-id = /bits/ 16 <0x4517>;
		device-id = /bits/ 16 <0x0204>;
		manufacturer = "Realtek";
		product = "USB2.0 7-Port Hub";
		serial = "000000001";
		self-powered;
		multi-tt;
		string-support;
		individual-port-switching;
		power-on-time-ms = <100>;
		sp-max-total-current-microamp = <2000>;
		sp-max-removable-current-microamp = <2000>;
		port-map = <2 1 4 3 6 5 7>;
		swap-dx-lanes = <3 4>;
		non-removable-ports = <7>;
		sp-disabled-ports = <5 6>;
	};
};

&pinctrl {
	gpio-line-names =
	"", "", "", "", "", "", "", "", // 0~7
	"PGOOD", "",  // 8,9
	"CHASSIS_INTRUSION",                    // 10
	"", "", "", "", "", "", "", "", "", "",  // 11~20
	"", "", "", "", "", "", "", "", "", "",  // 21~30
	"", "", "", "", "", "", "", "", "", "",  // 31~40
	"", "", "", "", "", "", "", "", "", "",  // 41~50
	"", "", "", "", "", "", "", "", "", "",  // 51~60
	"", "", "", "", "", "", "", "", "", "",  // 61~70
	"", "", "", "", "", "", "", "", "", "",  // 71~80
	"", "", "", "", "", "", "", "", "";      // 81~88
};

&i2c1 {
	status = "okay";

	ssif-bmc@10 {
		compatible = "ssif-bmc";
		reg = <0x40000010>;
	};
};
