#include "rts4930a.dtsi"

/ {
	model = "RTS493xA ESCM";
	compatible = "realtek,rts493xa-escm","realtek,rts493xa";

	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&gic>;

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x8000000>;
	};

	chosen {
		bootargs = "console=ttyS1,57600 init=/sbin/init earlyprintk rootfstype=squashfs user_debug=31";
		stdout-path = &uart1;
	};

	iio-hwmon {
			compatible = "iio-hwmon";
			io-channels = <&rts_adc 0>,
					<&rts_adc 1>,
					<&rts_adc 2>,
					<&rts_adc 3>;
					/* Channels should correspond to the adc enabled channels
					<&rts_adc 4>,
					<&rts_adc 5>,
					<&rts_adc 6>,
					<&rts_adc 7>;
					*/
	};
};

&spi0 {
	status = "okay";
	spi-transfer-channel = "quad";
	swp_enable;
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "u-boot";
			reg = <0x00000 0x180000>; //24*64K for uboot
		};

		partition@180000 {
			label = "uboot-env";
			reg = <0x180000 0x80000>; //8*64K for uboot env
		};

		partition@200000 {
			label = "kernel";
			reg = <0x200000 0x880000>; // 68*128K
		};

		partition@a80000 {
			label = "rofs";
			reg = <0xa80000 0xb600000>; //1456*128K
		};

		partition@c080000 {
			label = "rwfs";
			reg = <0xc080000 0x3f80000>; //508*128K
		};
	};
};

&leds {
	ledbmc: identify {
		gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&uart0 {
	status = "okay";
};

&i2c0 {
	status = "okay";

	rts493xa-mfd@30 {
		compatible = "realtek,rts591x-mfd-i2c";
		reg = <0x30>;

		mfd-gpios = <&pinctrl 37 GPIO_ACTIVE_LOW>;

		peci {
			compatible = "realtek,rts591x-peci";
			reg = <0x400a0000>;
			status = "okay";
		};

		gpio {
			compatible = "realtek,rts591x-gpio";
			reg = <0x40090000>;
			status = "okay";
		};

		rts_adc: adc {
			compatible = "realtek,rts591x-adc";
			reg = <0x4000FE00>;
			linear-Calibration;
			mode = "repeat";
			status = "okay";
			#io-channel-cells = <1>;

			channel@0{
				channel-en = "enabled";
				low-pass-filter;
			};

			channel@1{
				channel-en = "enabled";
				low-pass-filter;
			};

			channel@2{
				channel-en = "enabled";
				low-pass-filter;
			};

			channel@3{
				channel-en = "enabled";
				low-pass-filter;
			};

			channel@4{
				channel-en = "disabled";
				low-pass-filter;
			};

			channel@5{
				channel-en = "disabled";
				low-pass-filter;
			};

			channel@6{
				channel-en = "disabled";
				low-pass-filter;
			};

			channel@7{
				channel-en = "disabled";
				low-pass-filter;
			};


		};

		pwm_fan {
			compatible = "realtek,rts591x-pwm-fan";
			status = "okay";

			pwms {
				reg = <0x4000f000>;
				clock-config= <0x800  0>; /* clock divider , clock source selection*/
			};

			fans {
				reg = <0x4000fd00>;
				edge-selection = <0>;
				cnt-ready-interrupt-en;

				fan@0 {
					reg = <0x00>;
					fan-tach-ch = /bits/ 8 <0x00>;
				};

				fan@1 {
					reg = <0x01>;
					fan-tach-ch = /bits/ 8 <0x01>;
				};

				fan@2 {
					reg = <0x02>;
					fan-tach-ch = /bits/ 8 <0x02>;
				};

				fan@3 {
					reg = <0x03>;
					fan-tach-ch = /bits/ 8 <0x03>;
				};
			};

		};
	};

	rts490xa-hub@70 {
		compatible = "realtek,rts490xa-hub";
		reg = <0x70>;

		cp0-ldo-en = "enabled";
		cp1-ldo-en = "enabled";
		cp0-ldo-volt = "1.8V";
		cp1-ldo-volt = "1.8V";
		tp0145-ldo-en = "enabled";
		tp2367-ldo-en = "enabled";
		tp0145-ldo-volt = "1.8V";
		tp2367-ldo-volt = "1.8V";
		tp0145-pullup = "500R";
		tp2367-pullup = "500R";
		tp0145-io-strength = "30Ohms";
		tp2367-io-strength = "30Ohms";
		cp0-io-strength = "20Ohms";
		cp1-io-strength = "20Ohms";

		target-port@0 {
			mode = "smbus";
			pullup = "enabled";
			mctp-controller;
			backend@0,0 {
				compatible = "mctp-i2c-controller";
				target-reg = <0x10>;
			};
		};

		target-port@1 {
			mode = "smbus";
			pullup = "enabled";
			backend@0,0 {
				compatible = "slave-mqueue";
				target-reg = <0x10>;
			};
		};

		target-port@4 {
			mode = "smbus";
			pullup = "enabled";
			backend@0,0 {
				compatible = "slave-mqueue";
				target-reg = <0x10>;
			};
		};

		target-port@5 {
			mode = "smbus";
			pullup = "enabled";
			backend@0,0 {
				compatible = "slave-mqueue";
				target-reg = <0x10>;
			};
		};
	};
};

&pinctrl {
	gpio-line-names =
	"", "", "", "", "", "", "", "", // 0~7
	"PGOOD", "",  // 8,9
	"CHASSIS_INTRUSION",                    // 10
	"", "", "", "", "", "", "", "", "", "",  // 11~20
	"", "", "", "", "", "", "", "", "", "",  // 21~30
	"", "", "", "", "", "", "", "", "", "",  // 31~40
	"", "", "", "", "", "", "", "", "", "",  // 41~50
	"", "", "", "", "", "", "", "", "", "",  // 51~60
	"", "", "", "", "", "", "", "", "", "",  // 61~70
	"", "", "", "", "", "", "", "", "", "",  // 71~80
	"", "", "", "", "", "", "", "", "";      // 81~88
};

&i2c1 {
	status = "okay";

	ssif-bmc@10 {
		compatible = "ssif-bmc";
		reg = <0x40000010>;
	};
};
